# SPA fallback for the jriq.in root deployment (Apache / LiteSpeed shared hosting).
# All unknown paths serve index.html so client-side routes and QR deep links work:
#   https://jriq.in/store/<slug>   -> index.html -> React Router resolves the shop
# GitHub Pages ignores this file (it uses public/404.html + the index restore script).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # v1.1.x: permanent HTTP redirect for legacy customer URLs /store/<slug> -> /<slug>.
  # This is the ONLY way to answer a real 301 for arbitrary shop paths on this host;
  # the SPA also keeps a client-side /store/:slug redirect for hosts that ignore
  # .htaccess (GitHub Pages /gift/). No loop: the target /<slug> never matches again.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^store/([^/]+)/?$ /$1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
