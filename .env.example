# Optional — Supabase (leave unset to run in localStorage demo mode).
# Never commit real keys; use hosting environment variables in production.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

VITE_GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=ChIJwVPgCwAdwTsR7AHj3vrZvA4

# Canonical production origin used to build the customer campaign URL for QR
# codes and printed links (no trailing slash). When unset the QR falls back to
# the current origin + Vite base, which still works on Vercel and GitHub Pages.
# VITE_PUBLIC_APP_URL=https://gift-alpha-pearl.vercel.app

